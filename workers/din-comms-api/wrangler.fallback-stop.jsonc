// LOCAL REVIEW ONLY. Same class, namespace, migrations and encrypted records; forced stop regardless of env.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "din-comms-api",
  "main": "src/fallback-stop.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "VECTOR_KV",
      "id": "eb8e5b4209b640aaa80e5f3334eb5453"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VECTOR_NOTIFICATIONS",
        "class_name": "VectorNotificationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "vector-notifications-sqlite-v1",
      "new_sqlite_classes": [
        "VectorNotificationCoordinator"
      ]
    }
  ],
  "vars": {
    "VECTOR_NOTIFICATION_MODE": "migration-stop",
    "UNREAD_BYTE_CAP": 1048576
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
